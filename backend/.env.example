# Copy to .env and fill in values. Never commit .env.

# Nyckel API credentials (https://www.nyckel.com)
NYCKEL_CLIENT_ID=
NYCKEL_CLIENT_SECRET=

# Firebase storage bucket holding the baseline data spreadsheet
FIREBASE_STORAGE_BUCKET_URL=
BASELINE_DATA_FILE_PATH=

# Optional: set to "production" in deployed environments to hide error details
NODE_ENV=

# Optional: port to listen on (defaults to 8080)
PORT=
